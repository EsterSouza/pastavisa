        "docxtemplater": "^3.68.5",
        "mammoth": "^1.12.0",
        "next": "14.2.35",
        "pdf-lib": "^1.17.1",
        "pdf-parse": "^2.4.5",
        "pg": "^8.21.0",
        "pizzip": "^3.2.0",
        "prisma": "^7.8.0",

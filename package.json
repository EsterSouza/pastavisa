        "repair:docx": "node scripts/repair-corrupted-docx.js",
        "lint": "next lint",
        "sync:templates": "node scripts/sync-local-templates-to-supabase.js",
        "test": "vitest",
        "test:run": "vitest run",
        "test:watch": "vitest",
        "check:public-boundary": "node scripts/check-public-boundary.mjs",
        "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
        "test:e2e:report": "playwright show-report playwright-report"

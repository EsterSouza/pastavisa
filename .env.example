ANTHROPIC_API_KEY=

# Segredo HMAC exclusivo do planner publico. Gere um valor aleatorio forte e
# mantenha somente no servidor; nunca use prefixo NEXT_PUBLIC_.
PLANNER_SIGNING_SECRET=

# Postgres. Vazio = SQLite local em prisma/dev.db (so desenvolvimento).
# Producao: banco `pastavisa` na caixa `data`, role `pastavisa_app`.
DATABASE_URL=

# Arquivos. Com S3_ENDPOINT preenchido o driver e `s3` (Garage); sem ele, `local`
# (pasta storage/). FILE_STORAGE_DRIVER forca um dos dois.
FILE_STORAGE_DRIVER=
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=pastavisa
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Login pelo Keycloak (OIDC). Realm `treinavisa`, client confidencial `pastavisa`
# com os papeis `admin` e `operador`.
OIDC_ISSUER=https://login.treinavisa.com.br/realms/treinavisa
OIDC_CLIENT_ID=pastavisa
OIDC_CLIENT_SECRET=
# Endereco publico do app; o callback do login e APP_URL/api/auth/callback.
APP_URL=
# Assina o cookie de sessao. Minimo de 32 caracteres (openssl rand -hex 32).
SESSION_SECRET=

# Cron de retencao (/api/cron/retencao-pastas), chamado com Bearer pelo timer da caixa.
CRON_SECRET=

# Pasta local com os .docx de template, usada pelo script
# scripts/sync-local-templates.js. Opcional: se vazio, o script
# tenta um caminho padrao e depois a pasta TODOS_OS_TEMPLATES_PastaVISA no projeto.
TEMPLATE_SOURCE_DIR=

# E-mails para a cliente (lib/emails/smtp.ts): caixa da Hostinger, mesmo SMTP do InspecVISA.
SMTP_USER=
SMTP_PASS=
# Opcionais: SMTP_HOST (smtp.hostinger.com), SMTP_PORT (465), SMTP_FROM ("TreinaVISA <email>"), SMTP_BCC (cópia oculta)
